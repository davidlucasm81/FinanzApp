rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if user is an approved member
    function isMember(familyId) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) ||
        existsAfter(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
      );
    }

    // Helper to check if user is an admin or owner
    function isAdmin(familyId) {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'owner')) ||
        (existsAfter(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
         (getAfter(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin' ||
          getAfter(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'owner'))
      );
    }

    // 1. User Rules
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;

      allow update: if (request.auth != null && request.auth.uid == uid)
        && (
          // Allow updates if isPremium field is NOT being changed
          !request.resource.data.diff(resource.data).changedKeys().contains('isPremium')
          // Allow setting isPremium to false
          || request.resource.data.isPremium == false
          // Allow setting isPremium to true ONLY if the user is in the whitelist
          // We use the email from the token directly
          || exists(/databases/$(database)/documents/premium_whitelist/$(request.auth.token.email.lower()))
        );

      match /memberships/{familyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 2. Families and Subcollections
    match /families/{familyId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if isAdmin(familyId);

      match /members/{memberId} {
        allow read: if isMember(familyId);
        allow create, update, delete: if isAdmin(familyId) || (request.auth != null && request.auth.uid == memberId);
      }

      match /invitations/{invitationId} {
        allow read: if request.auth != null && (isMember(familyId) || request.auth.uid == resource.data.requestedByUid || request.auth.token.email == resource.data.targetEmail);
        allow create: if request.auth != null && (request.resource.data.type == 'code_request' || (request.resource.data.type == 'email_invite' && isAdmin(familyId)));
        allow delete: if isAdmin(familyId) || (request.auth != null && request.auth.uid == resource.data.requestedByUid) || (request.auth != null && request.auth.token.email == resource.data.targetEmail);
        allow update: if isAdmin(familyId) || (request.auth != null && request.auth.uid == resource.data.requestedByUid && request.resource.data.status == 'rejected') || (request.auth != null && request.auth.token.email == resource.data.targetEmail && request.resource.data.status in ['accepted', 'rejected']);
      }

      match /accounts/{accountId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId);
        allow update: if isAdmin(familyId) || (isMember(familyId) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['currentBalance']));
        allow delete: if isAdmin(familyId);
      }

      match /categories/{categoryId} {
        allow read, write: if isMember(familyId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isMember(familyId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isMember(familyId);
      }
    }

    // 3. Collection Group rules
    match /{path=**}/invitations/{invitationId} {
      allow read: if request.auth != null && (request.auth.token.email == resource.data.targetEmail || request.auth.uid == resource.data.requestedByUid);
    }

    match /{path=**}/transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // 4. Premium Whitelist
    match /premium_whitelist/{email} {
      // Allow reading own whitelist entry
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
